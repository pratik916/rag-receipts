# Copy to .env and fill in. These are passed to the api container ONLY —
# the web container never sees vendor keys.
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
COHERE_API_KEY=

# --- DEMO_MODE (Railway public demo only) -----------------------------------
# Set DEMO_MODE=1 on the public host to enable the cost-control layer
# (per-IP rate limits, a global daily budget, read-only ingest/eval, and a
# corpus allow-list on /query). Leave DEMO_MODE unset for local development —
# every demo check is a no-op when it is unset, so local behavior is unchanged.
DEMO_MODE=
DEMO_DAILY_BUDGET_USD=2.0
DEMO_RATE_PER_MIN=5
DEMO_RATE_PER_DAY=20
DEMO_S2_TOKEN_CEILING=20000
DEMO_CORPUS_ID=demo
# Where the committed demo corpus + example traces live (read by the startup
# seed/materialize step). Defaults suit local dev; override on the host if the
# files are mounted elsewhere.
RAGRECEIPTS_DEMO_CORPUS_DIR=../demo/corpus
RAGRECEIPTS_DEMO_EXAMPLES_DIR=../demo/examples
# Committed receipts dir (Ablation Lab). Default suits local dev; on the baked image
# (docker-compose / Railway) override to the in-image path, e.g. /app/receipts.
RAGRECEIPTS_RECEIPTS_DIR=../receipts
